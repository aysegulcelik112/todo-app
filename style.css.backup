@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Courier+Prime:wght@400;700&family=Special+Elite&display=swap');

:root {
  --paper-cream: #f4ede1;
  --paper-light: #faf7f0;
  --ink: #1a1614;
  --ink-fade: #4a3f35;
  --accent-rust: #c84630;
  --accent-teal: #2d6e73;
  --accent-mustard: #d4a55f;
  --border-dark: #3d3228;
  --shadow-vintage: rgba(26, 22, 20, 0.25);
  --dot-pattern: rgba(26, 22, 20, 0.08);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32px 20px;
  font-family: 'Courier Prime', 'Courier New', monospace;
  color: var(--ink);
  background: 
    repeating-linear-gradient(0deg, transparent, transparent 2px, var(--dot-pattern) 2px, var(--dot-pattern) 3px),
    repeating-linear-gradient(90deg, transparent, transparent 2px, var(--dot-pattern) 2px, var(--dot-pattern) 3px),
    linear-gradient(135deg, #d4c4a8 0%, #b8a88e 100%);
  position: relative;
}

body::before {
  content: '';
  position: fixed;
  inset: 0;
  background: 
    radial-gradient(circle at 20% 30%, rgba(200, 70, 48, 0.05), transparent 40%),
    radial-gradient(circle at 80% 70%, rgba(45, 110, 115, 0.05), transparent 40%);
  pointer-events: none;
  z-index: 1;
}

.app {
  width: min(90vw, 720px);
  background: var(--paper-light);
  border: 4px solid var(--border-dark);
  box-shadow: 
    0 0 0 2px var(--paper-cream),
    0 0 0 6px var(--border-dark),
    12px 12px 0 rgba(0, 0, 0, 0.15),
    0 20px 40px var(--shadow-vintage);
  position: relative;
  z-index: 2;
  overflow: hidden;
  transform: rotate(-0.5deg);
}

.app::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 16px;
  background: 
    repeating-linear-gradient(90deg, 
      var(--accent-rust) 0px, var(--accent-rust) 8px,
      var(--ink) 8px, var(--ink) 16px,
      var(--accent-teal) 16px, var(--accent-teal) 24px,
      var(--ink) 24px, var(--ink) 32px,
      var(--accent-mustard) 32px, var(--accent-mustard) 40px,
      var(--ink) 40px, var(--ink) 48px
    );
}

.app::after {
  content: '';
  position: absolute;
  inset: 0;
  background: 
    repeating-linear-gradient(0deg, transparent, transparent 1px, rgba(26, 22, 20, 0.02) 1px, rgba(26, 22, 20, 0.02) 2px);
  pointer-events: none;
}

h1 {
  margin: 0;
  padding: 32px 40px 24px;
  text-align: center;
  font-family: 'Playfair Display', Georgia, serif;
  font-size: clamp(2.5rem, 6vw, 4.2rem);
  font-weight: 900;
  letter-spacing: 0.02em;
  text-transform: uppercase;
  color: var(--ink);
  line-height: 1;
  position: relative;
  border-bottom: 4px double var(--border-dark);
  text-shadow: 2px 2px 0 rgba(212, 165, 95, 0.3);
}

h1::before {
  content: '✦ ';
  font-size: 0.7em;
  margin-right: 10px;
  color: var(--accent-rust);
}

h1::after {
  content: ' ✦';
  font-size: 0.7em;
  margin-left: 10px;
  color: var(--accent-teal);
}

.quote-banner {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
  padding: 24px 40px;
  background: 
    linear-gradient(90deg, 
      transparent 0%, 
      rgba(212, 165, 95, 0.08) 20%, 
      rgba(212, 165, 95, 0.08) 80%, 
      transparent 100%
    ),
    var(--paper-light);
  border-bottom: 1px dashed var(--ink-fade);
  position: relative;
}

.quote-banner::before {
  content: '❖';
  position: absolute;
  left: 40px;
  color: var(--accent-rust);
  font-size: 1.2em;
  opacity: 0.5;
}

.quote-banner::after {
  content: '❖';
  position: absolute;
  right: 40px;
  color: var(--accent-teal);
  font-size: 1.2em;
  opacity: 0.5;
}

.quote-mark {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: 3rem;
  line-height: 1;
  color: var(--accent-mustard);
  opacity: 0.6;
  font-weight: 700;
}

.quote-content {
  flex: 1;
  text-align: center;
  max-width: 500px;
}

.quote-text {
  margin: 0 0 8px 0;
  font-family: 'Playfair Display', Georgia, serif;
  font-size: 1.05rem;
  line-height: 1.5;
  color: var(--ink);
  font-style: italic;
  font-weight: 600;
  letter-spacing: 0.01em;
}

.quote-author {
  margin: 0;
  font-family: 'Courier Prime', monospace;
  font-size: 0.85rem;
  color: var(--ink-fade);
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.todo-form {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 28px 40px;
  background: 
    repeating-linear-gradient(45deg, transparent, transparent 10px, rgba(26, 22, 20, 0.02) 10px, rgba(26, 22, 20, 0.02) 20px),
    var(--paper-cream);
  border-bottom: 2px solid var(--border-dark);
}

.form-main {
  display: flex;
  gap: 12px;
}

.form-options {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.error-message {
  display: block;
  margin: 0 40px;
  padding: 18px 28px;
  background: 
    linear-gradient(135deg, var(--accent-rust) 0%, #b8402f 100%);
  color: var(--paper-light);
  font-family: 'Courier Prime', monospace;
  font-size: 0.95rem;
  font-weight: 700;
  text-align: center;
  border: none;
  border-bottom: 3px solid var(--border-dark);
  box-shadow: 
    inset 0 1px 0 rgba(255, 255, 255, 0.2),
    0 4px 12px rgba(200, 70, 48, 0.3);
  z-index: 10;
  opacity: 1;
  transform: translateY(0);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  letter-spacing: 0.05em;
  position: relative;
  animation: slideDown 0.3s ease;
}

.error-message::before {
  content: '⚠';
  margin-right: 10px;
  font-size: 1.2em;
  filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.3));
  animation: swing 0.6s ease infinite alternate;
}

.error-message::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: -6px;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 8px solid transparent;
  border-right: 8px solid transparent;
  border-top: 6px solid var(--border-dark);
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes swing {
  0% { transform: rotate(-5deg); }
  100% { transform: rotate(5deg); }
}

input[type='text'].error-shake {
  animation: shake 0.5s ease;
  border-color: var(--accent-rust);
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  10%, 30%, 50%, 70%, 90% { transform: translateX(-5px); }
  20%, 40%, 60%, 80% { transform: translateX(5px); }
}

input[type='text'] {
  flex: 1;
  background: #fffef8;
  border: 3px solid var(--border-dark);
  border-radius: 0;
  padding: 14px 18px;
  font-size: 1rem;
  font-weight: 400;
  color: var(--ink);
  outline: none;
  font-family: 'Special Elite', 'Courier New', monospace;
  transition: all 0.15s ease;
  box-shadow: inset 2px 2px 4px rgba(0, 0, 0, 0.08);
}

input[type='text']::placeholder {
  color: var(--ink-fade);
  font-style: italic;
}

input[type='text']:focus {
  background: #fff;
  border-color: var(--accent-teal);
  box-shadow: inset 2px 2px 4px rgba(0, 0, 0, 0.08), 0 0 0 3px rgba(45, 110, 115, 0.15);
}

.priority-select,
.category-select,
.deadline-input {
  background: #fffef8;
  border: 3px solid var(--border-dark);
  border-radius: 0;
  padding: 10px 14px;
  font-size: 0.9rem;
  font-weight: 700;
  color: var(--ink);
  outline: none;
  font-family: 'Courier Prime', monospace;
  cursor: pointer;
  box-shadow: 2px 2px 0 rgba(26, 22, 20, 0.1);
  transition: all 0.15s ease;
}

.priority-select:hover,
.category-select:hover,
.deadline-input:hover {
  box-shadow: 3px 3px 0 rgba(26, 22, 20, 0.15);
  transform: translate(-1px, -1px);
}

.priority-select {
  flex: 1;
  min-width: 150px;
}

.category-select {
  flex: 1;
  min-width: 150px;
}

.deadline-input {
  flex: 1;
  min-width: 150px;
}

button {
  border: 0;
  border-radius: 0;
  cursor: pointer;
  font-weight: 700;
  font-family: 'Courier Prime', monospace;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  transition: all 0.15s ease;
  position: relative;
}

button:hover {
  transform: translate(-2px, -2px);
}

button:active {
  transform: translate(0, 0);
}

#add-btn {
  background: var(--accent-rust);
  color: var(--paper-light);
  padding: 16px 32px;
  min-width: 120px;
  font-size: 0.9rem;
  border: 3px solid var(--border-dark);
  box-shadow: 4px 4px 0 var(--border-dark);
  text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.3);
}

#add-btn:hover {
  box-shadow: 6px 6px 0 var(--border-dark);
  background: #d45540;
}

.list-topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  flex-wrap: wrap;
  padding: 18px 40px;
  background: 
    linear-gradient(90deg, var(--accent-mustard) 0%, var(--accent-mustard) 8px, transparent 8px);
  border-bottom: 2px solid var(--border-dark);
  border-top: 2px solid var(--border-dark);
}

.filter-buttons {
  display: flex;
  gap: 8px;
}

.filter-btn {
  background: rgba(255, 255, 255, 0.5);
  color: var(--ink);
  border: 2px solid var(--border-dark);
  padding: 8px 16px;
  font-size: 0.8rem;
  font-weight: 700;
  font-family: 'Courier Prime', monospace;
  cursor: pointer;
  transition: all 0.15s ease;
  box-shadow: 2px 2px 0 rgba(26, 22, 20, 0.1);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.filter-btn:hover {
  transform: translate(-1px, -1px);
  box-shadow: 3px 3px 0 rgba(26, 22, 20, 0.15);
}

.filter-btn.active {
  background: var(--accent-teal);
  color: var(--paper-light);
  box-shadow: 3px 3px 0 var(--border-dark);
}

.action-buttons {
  display: flex;
  gap: 12px;
  align-items: center;
}

.search-input {
  background: #fffef8;
  border: 2px solid var(--border-dark);
  padding: 8px 14px;
  font-size: 0.85rem;
  font-weight: 400;
  color: var(--ink);
  outline: none;
  font-family: 'Courier Prime', monospace;
  width: 200px;
  box-shadow: inset 1px 1px 3px rgba(0, 0, 0, 0.1);
}

.search-input:focus {
  border-color: var(--accent-teal);
  box-shadow: inset 1px 1px 3px rgba(0, 0, 0, 0.1), 0 0 0 2px rgba(45, 110, 115, 0.15);
}

.list-topbar::before {
  content: '◈ GÖREVLER';
  font-size: 0.85rem;
  font-weight: 700;
  letter-spacing: 0.15em;
  color: var(--ink);
  font-family: 'Courier Prime', monospace;
}

#clear-all-btn {
  background: var(--border-dark);
  color: var(--paper-light);
  border: 2px solid var(--ink);
  padding: 8px 16px;
  font-size: 0.75rem;
  font-weight: 700;
  transition: all 0.15s ease;
  box-shadow: 2px 2px 0 var(--ink);
}

#clear-all-btn:hover {
  background: var(--ink);
  transform: translate(-1px, -1px);
  box-shadow: 3px 3px 0 var(--accent-rust);
}

.todo-list {
  list-style: none;
  margin: 0;
  padding: 28px 40px 24px;
  display: flex;
  flex-direction: column;
  gap: 14px;
  background: var(--paper-light);
}

.todo-counter {
  padding: 24px 40px 32px;
  background: 
    repeating-linear-gradient(135deg, transparent, transparent 10px, rgba(26, 22, 20, 0.02) 10px, rgba(26, 22, 20, 0.02) 20px),
    var(--paper-cream);
  border-top: 2px solid var(--border-dark);
  display: flex;
  flex-direction: column;
  gap: 16px;
  align-items: center;
}

.counter-badge {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px 28px;
  background: 
    linear-gradient(135deg, var(--accent-teal) 0%, #246166 100%);
  border: 3px solid var(--border-dark);
  box-shadow: 
    4px 4px 0 rgba(26, 22, 20, 0.2),
    inset 0 1px 0 rgba(255, 255, 255, 0.2);
  font-family: 'Courier Prime', monospace;
  position: relative;
}

.counter-badge::before,
.counter-badge::after {
  content: '◆';
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  color: var(--accent-mustard);
  font-size: 0.8em;
  opacity: 0.8;
}

.counter-badge::before {
  left: 8px;
}

.counter-badge::after {
  right: 8px;
}

.counter-label {
  font-size: 0.85rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.9);
  text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.3);
}

.counter-number {
  font-size: 1.8rem;
  font-weight: 700;
  color: var(--accent-mustard);
  text-shadow: 
    2px 2px 0 rgba(0, 0, 0, 0.3),
    0 0 10px rgba(212, 165, 95, 0.5);
  transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  display: inline-block;
  min-width: 32px;
  text-align: center;
}

.counter-stats {
  display: flex;
  align-items: center;
  gap: 16px;
  font-family: 'Courier Prime', monospace;
  font-size: 0.9rem;
  color: var(--ink);
  font-weight: 700;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 6px 12px;
  background: rgba(255, 255, 255, 0.5);
  border: 2px solid var(--border-dark);
  box-shadow: 2px 2px 0 rgba(26, 22, 20, 0.1);
}

.stat-icon {
  font-size: 1.1em;
  color: var(--accent-rust);
}

.stat-divider {
  color: var(--ink-fade);
  font-weight: 400;
}

.todo-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  padding: 16px 20px 16px 12px;
  background: #fffef8;
  border: 3px solid var(--border-dark);
  border-left: 8px solid var(--accent-teal);
  transition: all 0.15s ease;
  position: relative;
  box-shadow: 3px 3px 0 rgba(26, 22, 20, 0.15);
}

.todo-item.priority-high {
  border-left-color: var(--accent-rust);
}

.todo-item.priority-medium {
  border-left-color: var(--accent-mustard);
}

.todo-item.priority-low {
  border-left-color: var(--accent-teal);
}

.todo-item:hover {
  background: #fffff5;
  box-shadow: 5px 5px 0 rgba(26, 22, 20, 0.2);
  transform: translate(-1px, -1px);
}

.priority-bar {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8px;
}

.todo-content-wrapper {
  display: flex;
  flex-direction: column;
  gap: 6px;
  flex: 1;
}

.todo-meta {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  align-items: center;
}

.category-badge,
.deadline-badge {
  font-size: 0.75rem;
  padding: 3px 8px;
  border: 2px solid var(--border-dark);
  font-family: 'Courier Prime', monospace;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.03em;
  box-shadow: 1px 1px 0 rgba(26, 22, 20, 0.1);
}

.category-badge {
  background: rgba(45, 110, 115, 0.15);
  color: var(--ink);
}

.category-work { background: rgba(100, 100, 255, 0.15); }
.category-personal { background: rgba(255, 150, 100, 0.15); }
.category-shopping { background: rgba(100, 200, 100, 0.15); }
.category-health { background: rgba(255, 100, 100, 0.15); }
.category-learning { background: rgba(150, 100, 255, 0.15); }
.category-other { background: rgba(200, 200, 200, 0.15); }

.deadline-badge {
  background: rgba(212, 165, 95, 0.2);
  color: var(--ink);
}

.deadline-badge.overdue {
  background: var(--accent-rust);
  color: var(--paper-light);
  animation: blink 1s ease infinite;
}

.deadline-badge.today {
  background: var(--accent-mustard);
  color: var(--ink);
  font-weight: 900;
}

@keyframes blink {
  0%, 50% { opacity: 1; }
  51%, 100% { opacity: 0.7; }
}

.todo-label {
  display: flex;
  align-items: center;
  gap: 14px;
  flex: 1;
  min-width: 0;
  cursor: pointer;
}

.todo-checkbox {
  width: 22px;
  height: 22px;
  cursor: pointer;
  accent-color: var(--accent-rust);
  flex-shrink: 0;
  border: 2px solid var(--ink);
}

.todo-text {
  display: inline-block;
  width: 100%;
  color: var(--ink);
  word-break: break-word;
  line-height: 1.6;
  font-size: 1rem;
  font-weight: 400;
  font-family: 'Courier Prime', monospace;
  transition: all 0.2s ease;
}

.todo-text.completed {
  text-decoration: line-through;
  text-decoration-thickness: 2px;
  text-decoration-color: var(--accent-rust);
  color: var(--ink-fade);
  opacity: 0.6;
}

.edit-input {
  display: none;
  flex: 1;
  min-width: 0;
  border: 2px solid var(--accent-teal);
  border-radius: 0;
  background: #fff;
  color: var(--ink);
  padding: 8px 12px;
  font-size: 1rem;
  font-weight: 400;
  font-family: 'Courier Prime', monospace;
  outline: none;
  box-shadow: inset 2px 2px 4px rgba(0, 0, 0, 0.1);
}

.edit-input:focus {
  box-shadow: inset 2px 2px 4px rgba(0, 0, 0, 0.1), 0 0 0 3px rgba(45, 110, 115, 0.2);
}

.edit-btn,
.delete-btn {
  padding: 9px 16px;
  font-size: 0.75rem;
  border-radius: 0;
  font-weight: 700;
  border: 2px solid var(--border-dark);
}

.edit-btn {
  background: var(--accent-mustard);
  color: var(--ink);
  box-shadow: 2px 2px 0 var(--border-dark);
}

.edit-btn:hover {
  box-shadow: 3px 3px 0 var(--border-dark);
  background: #e0b770;
}

.delete-btn {
  background: var(--ink);
  color: var(--paper-light);
  box-shadow: 2px 2px 0 var(--accent-rust);
}

.delete-btn:hover {
  background: var(--accent-rust);
  box-shadow: 3px 3px 0 var(--border-dark);
}

@media (max-width: 680px) {
  body {
    padding: 16px 12px;
  }

  .app {
    width: 100%;
    transform: rotate(0);
  }

  h1 {
    font-size: clamp(2rem, 7vw, 2.8rem);
    padding: 28px 24px 20px;
  }

  h1::before,
  h1::after {
    font-size: 0.6em;
  }

  .quote-banner {
    padding: 20px 24px;
    gap: 12px;
  }

  .quote-banner::before,
  .quote-banner::after {
    display: none;
  }

  .quote-mark {
    font-size: 2rem;
    display: none;
  }

  .quote-text {
    font-size: 0.95rem;
  }

  .quote-author {
    font-size: 0.75rem;
  }

  .todo-form {
    flex-direction: column;
    padding: 20px 24px;
  }

  .form-main {
    flex-direction: column;
  }

  .form-options {
    flex-direction: column;
  }

  .priority-select,
  .category-select,
  .deadline-input {
    width: 100%;
    min-width: auto;
  }

  .error-message {
    margin: 0 24px;
    font-size: 0.88rem;
    padding: 16px 20px;
  }
  
  .error-message::after {
    border-left-width: 6px;
    border-right-width: 6px;
    border-top-width: 5px;
  }

  #add-btn {
    width: 100%;
    padding: 16px;
  }

  .list-topbar {
    padding: 14px 24px;
    flex-direction: column;
    align-items: stretch;
  }

  .list-topbar::before {
    font-size: 0.75rem;
    text-align: center;
    margin-bottom: 12px;
  }

  .filter-buttons {
    justify-content: center;
    margin-bottom: 12px;
  }

  .filter-btn {
    flex: 1;
    font-size: 0.7rem;
    padding: 8px 12px;
  }

  .action-buttons {
    flex-direction: column;
    width: 100%;
  }

  .search-input {
    width: 100%;
  }

  #clear-all-btn {
    width: 100%;
  }

  .todo-list {
    padding: 20px 24px 20px;
  }

  .todo-counter {
    padding: 20px 24px 28px;
  }

  .counter-badge {
    padding: 12px 20px;
    gap: 10px;
  }

  .counter-badge::before,
  .counter-badge::after {
    display: none;
  }

  .counter-label {
    font-size: 0.75rem;
  }

  .counter-number {
    font-size: 1.5rem;
  }

  .counter-stats {
    flex-direction: column;
    gap: 8px;
    font-size: 0.8rem;
  }

  .stat-divider {
    display: none;
  }

  .stat-item {
    width: 100%;
    justify-content: center;
  }

  .todo-item {
    flex-wrap: wrap;
    padding: 14px 16px 14px 10px;
    border-left-width: 6px;
  }

  .todo-label {
    flex: 1 1 100%;
    margin-bottom: 12px;
  }

  .todo-meta {
    font-size: 0.7rem;
  }

  .category-badge,
  .deadline-badge {
    font-size: 0.65rem;
    padding: 2px 6px;
  }

  .edit-btn,
  .delete-btn {
    flex: 1;
    font-size: 0.7rem;
  }
}
